# Backend API Base URL
# In development: http://localhost:5000 (or leave empty to use the Vite proxy)
# In production: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:5000

# Cloudflare Turnstile Site Key (Public)
# Get key at: https://dash.cloudflare.com/?to=/:account/turnstile
# Testing Site Key (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
