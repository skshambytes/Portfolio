# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Allowed Frontend Origin (for CORS and Origin Header verification)
# In production, set to your live frontend URL (e.g., https://your-site.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Required for contact form email delivery (Gmail SMTP or another SMTP provider)
# The API returns HTTP 503 rather than claiming success when these are missing or invalid.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rajsaksham744@gmail.com
SMTP_PASS=your_gmail_app_password_here
CONTACT_TO_EMAIL=rajsaksham744@gmail.com
CONTACT_FROM_EMAIL="Saksham Raj Portfolio" <rajsaksham744@gmail.com>

# Bot Protection (Cloudflare Turnstile)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# In local development, you can use Cloudflare's always-pass test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Security Salt for Anonymizing Client IP Addresses (HMAC SHA-256)
# Generate a strong 32+ character random string
IP_HASH_SALT=your_super_secret_ip_hash_salt_change_in_production_min_32_chars

# GitHub Personal Access Token (Optional, for higher rate limits on GET /api/projects)
GITHUB_TOKEN=
